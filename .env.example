# Environment Configuration for Cloud-Chat V2
# Copy this file to .env and configure your keys

# AI Providers
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=groq

# Safety Defaults (Keep safe by default!)
ENABLE_MOCK_MODE=True
ENABLE_REAL_TERRAFORM_APPLY=False

# AWS Configuration
AWS_DEFAULT_REGION=us-east-1

# Application / Database
SQLITE_DB_PATH=database/cloud_chat.db
WORKSPACE_ROOT=workspaces
LOG_LEVEL=INFO
